<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>XTray</AssemblyName>
    <RootNamespace>XTray.Tray</RootNamespace>
    <ApplicationIcon>..\..\packaging\XTray.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\packaging\XTray.ico" Link="XTray.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
